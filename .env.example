# Without keys the product uses pretrained frozen embeddings + factual templates.
# OpenAI GPT-6 Sol; ASTRA_* is the historical primary-provider prefix.
# Put a NEW key only into local .env, never chat, source files or GitHub.
ASTRA_API_PROTOCOL=openai-chat-completions
ASTRA_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
ASTRA_MODEL=gpt-6-sol
ASTRA_API_KEY_1=
ASTRA_API_KEY_2=
ASTRA_API_KEY_3=

# Optional second LLM; exact protocol/variable names are documented in README.
FALLBACK_LLM_API_PROTOCOL=openai-chat-completions
FALLBACK_LLM_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
FALLBACK_LLM_MODEL=gpt-4.1-mini-2025-04-14
FALLBACK_LLM_API_KEY=

# Runtime embeddings never call NVIDIA/NIM; reserved for a future explicit model rebuild.
NVIDIA_API_KEY=

# Real inquiries are disabled until the team explicitly configures its channel.
# Set smtp only after completing the sender settings; TLS is required.
INQUIRY_TRANSPORT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_EMAIL_TO=
# Alternative optional Telegram transport.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
INQUIRY_DB_PATH=.cache/inquiries.sqlite3
