# Without keys the product uses pretrained frozen embeddings + factual templates.
# Astra contract is not supplied. Enable ONLY after confirming protocol with provider docs.
ASTRA_API_PROTOCOL=
ASTRA_CHAT_COMPLETIONS_URL=
ASTRA_MODEL=
ASTRA_API_KEY_1=
ASTRA_API_KEY_2=
ASTRA_API_KEY_3=

# Optional second LLM; exact protocol/variable names are documented in README.
FALLBACK_LLM_API_PROTOCOL=
FALLBACK_LLM_CHAT_COMPLETIONS_URL=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=

# Runtime embeddings never call NVIDIA/NIM; reserved for a future explicit model rebuild.
NVIDIA_API_KEY=
